{
  "Comment": "A description of my state machine",
  "StartAt": "Set env vars",
  "States": {
    "Set env vars": {
      "Type": "Pass",
      "Next": "Enable SQS HeartBeat Scheduler Rule",
      "Assign": {
        "taskToken": "{% $states.input.taskToken ? $states.input.taskToken : null %}",
        "payload": "{% $states.input.payload %}"
      }
    },
    "Enable SQS HeartBeat Scheduler Rule": {
      "Type": "Task",
      "Arguments": {
        "Name": "${__sqs_heartbeat_scheduler_rule_name__}"
      },
      "Resource": "arn:aws:states:::aws-sdk:eventbridge:enableRule",
      "Retry": [
        {
          "ErrorEquals": ["EventBridge.InternalException"],
          "BackoffRate": 2,
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "Comment": "Handle internal event bridge exception"
        }
      ],
      "Next": "Set jobs"
    },
    "Set jobs": {
      "Type": "Parallel",
      "End": true,
      "Branches": [
        {
          "StartAt": "Has Task Token",
          "States": {
            "Has Task Token": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "Add task token to sqs queue list",
                  "Condition": "{% $taskToken ? true : false %}",
                  "Comment": "Has task token"
                }
              ],
              "Default": "Skip task token to db"
            },
            "Skip task token to db": {
              "Type": "Pass",
              "End": true
            },
            "Add task token to sqs queue list": {
              "Type": "Task",
              "Resource": "arn:aws:states:::dynamodb:putItem",
              "Arguments": {
                "TableName": "${__table_name__}",
                "Item": {
                  "id": {
                    "S": "{% $taskToken %}"
                  },
                  "id_type": {
                    "S": "TASK_TOKEN_SQS"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Add job to queue",
          "States": {
            "Add job to queue": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sqs:sendMessage",
              "Arguments": {
                "MessageBody": {
                  "taskToken": "{% $taskToken %}",
                  "payload": "{% $payload %}"
                },
                "QueueUrl": "${__copy_job_queue_url__}"
              },
              "End": true
            }
          }
        }
      ]
    }
  },
  "QueryLanguage": "JSONata"
}
